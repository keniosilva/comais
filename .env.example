# Copie para .env e preencha com valores locais. Nunca versione o .env.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL: se DB_NAME estiver definido, o sistema usa MySQL.
# Se ficar em branco/removido, usa SQLite local (apenas para desenvolvimento rápido).
DB_NAME=comais
DB_USER=comais_user
DB_PASSWORD=defina-uma-senha-local
DB_HOST=127.0.0.1
DB_PORT=3306
